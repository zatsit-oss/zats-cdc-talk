# Makefile pour déploiement K8s
GITHUB_REPO := zatsit-oss/zats-cdc-talk
REGISTRY := ghcr.io
FRONTEND_IMAGE := $(REGISTRY)/$(GITHUB_REPO)/frontend:latest
BACKEND_IMAGE := $(REGISTRY)/$(GITHUB_REPO)/backend:latest

# Build et push manuel (si besoin)
.PHONY: docker-build
docker-build:
	@echo "🔨 Building Docker images..."
	docker build -t $(FRONTEND_IMAGE) package/frontend
	docker build -t $(BACKEND_IMAGE) package/backend

.PHONY: docker-push
docker-push:
	@echo "📤 Pushing to GitHub Container Registry..."
	@echo "Login: echo \$$GITHUB_TOKEN | docker login ghcr.io -u USERNAME --password-stdin"
	docker push $(FRONTEND_IMAGE)
	docker push $(BACKEND_IMAGE)

# Déploiement K8s
.PHONY: k8s-deploy-app
k8s-deploy-app:
	@echo "🚀 Deploying frontend and backend to Kubernetes..."
	kubectl apply -f k8s/backend-deployment.yaml
	kubectl apply -f k8s/frontend-deployment.yaml

.PHONY: k8s-status
k8s-status:
	@echo "📊 Application status:"
	@kubectl get pods -l app=frontend
	@kubectl get pods -l app=backend
	@kubectl get service frontend
	@echo ""
	@echo "Frontend URL:"
	@kubectl get service frontend -o jsonpath='{.status.loadBalancer.ingress[0].ip}' && echo

.PHONY: k8s-logs-frontend
k8s-logs-frontend:
	kubectl logs -f -l app=frontend

.PHONY: k8s-logs-backend
k8s-logs-backend:
	kubectl logs -f -l app=backend

.PHONY: k8s-restart
k8s-restart:
	@echo "🔄 Restarting deployments..."
	kubectl rollout restart deployment/frontend
	kubectl rollout restart deployment/backend

.PHONY: k8s-delete-app
k8s-delete-app:
	@echo "🗑️ Deleting frontend and backend..."
	kubectl delete -f k8s/frontend-deployment.yaml
	kubectl delete -f k8s/backend-deployment.yaml

.PHONY: help-k8s
help-k8s:
	@echo "Commandes K8s disponibles:"
	@echo "  make docker-build       - Build les images Docker"
	@echo "  make docker-push        - Push vers ghcr.io"
	@echo "  make k8s-deploy-app     - Déployer frontend + backend"
	@echo "  make k8s-status         - Voir le status"
	@echo "  make k8s-logs-frontend  - Logs du frontend"
	@echo "  make k8s-logs-backend   - Logs du backend"
	@echo "  make k8s-restart        - Redémarrer l'app"
	@echo "  make k8s-delete-app     - Supprimer l'app"
